# Google OAuth 2.0 認証情報
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OneDrive (Azure AD) OAuth 2.0 認証情報（任意）
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# Dropbox OAuth 2.0 認証情報（任意・アクセストークン接続時は不要）
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# NextAuth 設定（必ず32文字以上のランダム文字列を生成して設定してください: openssl rand -base64 32）
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-key-at-least-32-chars

# 【任意・個人利用向けセキュリティ強化設定】
# ログインを許可するメールアドレス（カンマ区切り）。未設定の場合は制限なし
# ALLOWED_EMAILS=your-email@gmail.com
# WebDAV / Nextcloud の接続を許可するホスト名（カンマ区切り）。未設定の場合はプライベートIPのみ遮断
# ALLOWED_WEBDAV_HOSTS=my-nas.synology.me,cloud.example.com
# 使用しない認証プロバイダーを無効化したい場合（true で無効化）
# DISABLE_WEBDAV=false
# DISABLE_DROPBOX_TOKEN=false
